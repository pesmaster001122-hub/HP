import socket
import ast

client_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
server_address = ('127.0.0.1', 8080)

client_socket.connect(server_address)
print("Connected to server.")
print("Enter 'exit' to terminate.\n")

while True:
    matrix = input("Enter N x N matrix: ")
    client_socket.send(matrix.encode())

    if matrix.lower() == "exit":
        break

    try:
        matrix_list = ast.literal_eval(matrix)
        r = len(matrix_list)

        if r == 0 or any(len(row) != r for row in matrix_list):
            print("Invalid matrix format: Enter a square matrix.")
            continue

    except (ValueError, SyntaxError, TypeError):
        print("Invalid matrix format.")
        continue

    data = client_socket.recv(1024)
    result = data.decode()

    print("Matrix Type:", result)
    print()

client_socket.close()
print("Client terminated.")