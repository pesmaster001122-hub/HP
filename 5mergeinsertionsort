#include <stdio.h>
#define N 100
void merge(int a[],int l,int m,int r){int t[N],i=l,j=m+1,k=0;while(i<=m&&j<=r)t[k++]=a[i]<=a[j]?a[i++]:a[j++];while(i<=m)t[k++]=a[i++];while(j<=r)t[k++]=a[j++];for(i=0;i<k;i++)a[l+i]=t[i];}
void msort(int a[],int l,int r){if(l<r){int m=(l+r)/2;msort(a,l,m);msort(a,m+1,r);merge(a,l,m,r);}}
void isort(int a[],int n){for(int i=1;i<n;i++){int x=a[i],j=i-1;while(j>=0&&a[j]>x){a[j+1]=a[j];j--;}a[j+1]=x;}}
int main(){int a[N],b[N],n;printf("Number of elements: ");scanf("%d",&n);if(n<1||n>N)return 1;for(int i=0;i<n;i++){scanf("%d",&a[i]);b[i]=a[i];}msort(a,0,n-1);isort(b,n);printf("Merge sort: ");for(int i=0;i<n;i++)printf("%d ",a[i]);printf("\nInsertion sort: ");for(int i=0;i<n;i++)printf("%d ",b[i]);puts("");return 0;}