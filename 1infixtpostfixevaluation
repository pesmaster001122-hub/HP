#include <stdio.h>
#include <ctype.h>
#include <math.h>
#define N 100
char st[N]; int top=-1;
int prec(char c){if(c=='^')return 3;if(c=='*'||c=='/')return 2;if(c=='+'||c=='-')return 1;return 0;}
int op(char c){return c=='+'||c=='-'||c=='*'||c=='/'||c=='^';}
int main(){
char in[N],post[N]; double vs[26]={0},s[N],a,b; int known[26]={0},i,j=0,t=-1;
printf("Enter infix: ");scanf("%99s",in);
for(i=0;in[i];i++){char c=in[i];
if(isalnum((unsigned char)c))post[j++]=c;
else if(c=='(')st[++top]=c;
else if(c==')'){while(top>=0&&st[top]!='(')post[j++]=st[top--];if(top<0){puts("Invalid expression");return 1;}top--;}
else if(op(c)){while(top>=0&&st[top]!='('&&(prec(st[top])>prec(c)||(prec(st[top])==prec(c)&&c!='^')))post[j++]=st[top--];st[++top]=c;}
else{puts("Invalid character");return 1;}}
while(top>=0){if(st[top]=='('){puts("Invalid expression");return 1;}post[j++]=st[top--];}post[j]='\0';
printf("Postfix: %s\n",post);
for(i=0;post[i];i++){char c=post[i];
if(isdigit((unsigned char)c))s[++t]=c-'0';
else if(isalpha((unsigned char)c)){int k=tolower((unsigned char)c)-'a';if(!known[k]){printf("Value of %c: ",c);scanf("%lf",&vs[k]);known[k]=1;}s[++t]=vs[k];}
else if(op(c)){if(t<1){puts("Invalid postfix");return 1;}b=s[t--];a=s[t--];switch(c){case '+':s[++t]=a+b;break;case '-':s[++t]=a-b;break;case '*':s[++t]=a*b;break;case '/':if(b==0){puts("Divide by zero");return 1;}s[++t]=a/b;break;case '^':s[++t]=pow(a,b);}}
}
if(t!=0){puts("Invalid expression");return 1;}printf("Result: %.2f\n",s[t]);return 0;
}