#include <stdio.h>
#define N 5
int q[N],f=-1,r=-1;
int isEmpty(){return f==-1;}
int isFull(){return (r+1)%N==f;}
void enqueue(int x){if(isFull())puts("Queue full");else{if(isEmpty())f=r=0;else r=(r+1)%N;q[r]=x;}}
void dequeue(){if(isEmpty())puts("Queue empty");else{printf("Deleted %d\n",q[f]);if(f==r)f=r=-1;else f=(f+1)%N;}}
void display(){if(isEmpty()){puts("Empty");return;}int i=f;while(1){printf("%d ",q[i]);if(i==r)break;i=(i+1)%N;}puts("");}
int main(){int c,x;while(1){printf("1.Enqueue 2.Dequeue 3.Display 4.Exit: ");scanf("%d",&c);switch(c){case 1:scanf("%d",&x);enqueue(x);break;case 2:dequeue();break;case 3:display();break;case 4:return 0;default:puts("Invalid");}}}
