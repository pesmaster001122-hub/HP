#include <stdio.h>
#define N 20
int main(){
int a[N][2],b[N][2],c[2*N][2],n,m,i=0,j=0,k=0;
printf("Terms in polynomial 1: ");scanf("%d",&n);
for(int x=0;x<n;x++){printf("Coefficient exponent: ");scanf("%d%d",&a[x][0],&a[x][1]);}
printf("Terms in polynomial 2: ");scanf("%d",&m);
for(int x=0;x<m;x++){printf("Coefficient exponent: ");scanf("%d%d",&b[x][0],&b[x][1]);}
while(i<n&&j<m){if(a[i][1]==b[j][1]){c[k][0]=a[i][0]+b[j][0];c[k++][1]=a[i][1];i++;j++;}
else if(a[i][1]>b[j][1]){c[k][0]=a[i][0];c[k++][1]=a[i++][1];}
else{c[k][0]=b[j][0];c[k++][1]=b[j++][1];}}
while(i<n){c[k][0]=a[i][0];c[k++][1]=a[i++][1];}
while(j<m){c[k][0]=b[j][0];c[k++][1]=b[j++][1];}
printf("Sum: ");for(i=0;i<k;i++){if(i&&c[i][0]>=0)printf(" + ");else if(i)printf(" ");printf("%d",c[i][0]);if(c[i][1])printf("x");if(c[i][1]>1)printf("^%d",c[i][1]);}if(!k)printf("0");puts("");return 0;
}
